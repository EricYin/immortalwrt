+static int wcss_sec_prepare_userpd_bootargs(struct rproc *rproc)
+{
+	struct wcss_sec *wcss = rproc->priv;
+	struct wcss_bootargs_header *header;
+	struct wcss_userpd_bootargs *entry;
+	const struct elf32_hdr *ehdr;
+	const struct firmware *fw;
+	const char *fw_name;
+	ssize_t image_size;
+	size_t smem_size;
+	void *bootargs;
+	void *smem;
+	u32 smem_id;
+	int num_userpds;
+	int i;
+	int ret;
+
+	ret = of_property_read_u32(wcss->dev->of_node,
+				   "qcom,bootargs_smem", &smem_id);
+	if (ret)
+		return 0;
+
+	num_userpds = of_property_count_strings(wcss->dev->of_node,
+						 "upd-firmware-names");
+	if (num_userpds <= 0 || num_userpds > WCSS_USERPD_MAX)
+		return num_userpds < 0 ? num_userpds : -E2BIG;
+
+	bootargs = kzalloc(WCSS_BOOTARGS_SMEM_SIZE, GFP_KERNEL);
+	if (!bootargs)
+		return -ENOMEM;
+
+	header = bootargs;
+	header->version = cpu_to_le16(WCSS_BOOTARGS_VERSION);
+	header->data_len = cpu_to_le16(num_userpds * sizeof(*entry));
+	entry = bootargs + sizeof(*header);
+
+	for (i = 0; i < num_userpds; i++, entry++) {
+		ret = of_property_read_string_index(wcss->dev->of_node,
+						    "upd-firmware-names", i,
+						    &fw_name);
+		if (ret)
+			goto out_free;
+
+		ret = request_firmware(&fw, fw_name, wcss->dev);
+		if (ret)
+			goto out_free;
+
+		if (fw->size < sizeof(*ehdr)) {
+			ret = -EINVAL;
+			goto out_release;
+		}
+
+		ehdr = (const struct elf32_hdr *)fw->data;
+		if (memcmp(ehdr->e_ident, ELFMAG, SELFMAG) ||
+		    ehdr->e_ident[EI_CLASS] != ELFCLASS32) {
+			ret = -EINVAL;
+			goto out_release;
+		}
+
+		image_size = qcom_mdt_get_file_size(fw);
+		if (image_size <= 0 || image_size > U32_MAX) {
+			ret = image_size < 0 ? image_size : -EFBIG;
+			goto out_release;
+		}
+
+		entry->header.type = WCSS_USERPD_BOOTARGS_TYPE;
+		entry->header.length = sizeof(*entry) - sizeof(entry->header);
+		entry->pid = WCSS_USERPD_FIRST_PID + i;
+		entry->boot_addr = cpu_to_le32(ehdr->e_entry);
+		entry->data_size = cpu_to_le32(image_size);
+		dev_info(wcss->dev,
+			 "UserPD bootargs pid %u firmware %s addr 0x%x size 0x%x\n",
+			 entry->pid, fw_name, ehdr->e_entry, (u32)image_size);
+		release_firmware(fw);
+	}
+
+	ret = qcom_smem_alloc(WCSS_SMEM_HOST, smem_id,
+			      WCSS_BOOTARGS_SMEM_SIZE);
+	if (ret && ret != -EEXIST)
+		goto out_free;
+
+	smem = qcom_smem_get(WCSS_SMEM_HOST, smem_id, &smem_size);
+	if (IS_ERR(smem)) {
+		ret = PTR_ERR(smem);
+		goto out_free;
+	}
+	if (smem_size < WCSS_BOOTARGS_SMEM_SIZE) {
+		ret = -ENOSPC;
+		goto out_free;
+	}
+
+	memset_io(smem, 0, smem_size);
+	memcpy_toio(smem, bootargs, WCSS_BOOTARGS_SMEM_SIZE);
+	ret = 0;
+	goto out_free;
+
+out_release:
+	release_firmware(fw);
+out_free:
+	kfree(bootargs);
+	return ret;
+}
+
 static int wcss_sec_load(struct rproc *rproc, const struct firmware *fw)
 {
 	struct wcss_sec *wcss = rproc->priv;
 	struct device *dev = wcss->dev;
-	int ret;
+	const struct firmware *aux_fw;
+	int i, ret;
+
+	ret = wcss_sec_prepare_userpd_bootargs(rproc);
+	if (ret) {
+		dev_err(dev, "failed to prepare UserPD bootargs: %d\n", ret);
+		return ret;
+	}
 
 	ret = qcom_mdt_load(dev, fw, rproc->firmware, wcss->desc->pasid, wcss->mem_region,
 			    wcss->mem_phys, wcss->mem_size, &wcss->mem_reloc);
 	if (ret)
 		return ret;
 
+	for (i = 1; i < ARRAY_SIZE(wcss->firmware); i++) {
+		if (!wcss->firmware[i])
+			break;
+
+		ret = request_firmware(&aux_fw, wcss->firmware[i], dev);
+		if (ret)
+			return dev_err_probe(dev, ret, "failed to request firmware %s\n",
+					     wcss->firmware[i]);
+
+		ret = qcom_mdt_load_no_init(dev, aux_fw, wcss->firmware[i],
+					    wcss->mem_region, wcss->mem_phys,
+					    wcss->mem_size, &wcss->mem_reloc);
