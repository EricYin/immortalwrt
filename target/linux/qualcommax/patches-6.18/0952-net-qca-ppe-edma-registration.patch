From: ViKing <viking.yfy@qq.com>
Date: Tue, 27 Oct 2026 09:40:00 +0800
Subject: [PATCH] net: ethernet: qualcomm: register native AX PPE and EDMA drivers

Consolidate consecutive changes within this functional responsibility.
Retain the final implementation and its error handling directly.

Merged from:
  0952-net-ethernet-qca-add-ppe.patch
  0953-net-ethernet-qca-add-EDMA.patch

Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/drivers/net/ethernet/qualcomm/Kconfig
+++ b/drivers/net/ethernet/qualcomm/Kconfig
@@ -75,6 +75,24 @@
 	  To compile this driver as a module, choose M here. The module
 	  will be called qcom-ppe.
 
+config QCOM_80211AX_PPE
+	tristate "Qualcomm 802.11ax PPE switch driver"
+	depends on NET_DSA && QCOM_EDMA
+	select NET_DSA_TAG_QCA
+	select PCS_QCA_UNIPHY
+	select PHYLINK
+	select REGMAP_MMIO
+	select NET_REDIRECT
+	help
+	  Driver for Qualcomm 802.11ax PPE (Packet Processing Engine) switches.
+
+config QCOM_EDMA
+	tristate "EDMA dataplane ethernet driver for Qualcomm IPQ platforms"
+	select PAGE_POOL
+	help
+	  EDMA dataplane ethernet driver for Qualcomm IPQ platforms.
+
+
 source "drivers/net/ethernet/qualcomm/rmnet/Kconfig"
 
 endif # NET_VENDOR_QUALCOMM
--- a/drivers/net/ethernet/qualcomm/Makefile
+++ b/drivers/net/ethernet/qualcomm/Makefile
@@ -8,6 +8,9 @@
 qcaspi-objs := qca_7k.o qca_debug.o qca_spi.o
 obj-$(CONFIG_QCA7000_UART) += qcauart.o
 qcauart-objs := qca_uart.o
+obj-$(CONFIG_QCOM_80211AX_PPE) += qca_ppe.o
+qca_ppe-objs := qca_ppe_main.o qca_ppe_vlan.o qca_ppe_scheduler.o qca_ppe_debugfs.o qca_ppe_acl.o qca_ppe_flow.o qca_ppe_flow_offload.o
+obj-$(CONFIG_QCOM_EDMA) += qca_edma.o
 
 obj-y += emac/
 
